---
// ============================================
// Layout.astro — 核心全局布局
// ============================================
// 三区布局：Header（全宽）+ 主体（侧边栏 + 内容）+ Footer（全宽）
// 侧边栏默认在左侧，通过 sidebarPosition 可切换至右侧
// ============================================
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE, UMAMI_CONFIG } from "../consts";
import "../styles/global.css";

interface Props {
  /** 页面标题（会拼接站点名） */
  title?: string;
  /** 页面 meta description */
  description?: string;
  /** 是否显示侧边栏（默认 true） */
  showSidebar?: boolean;
  /** 侧边栏位置 "left" | "right"（默认 left） */
  sidebarPosition?: "left" | "right";
  /** 自定义 og:image */
  ogImage?: string;
}

const {
  title,
  description = SITE.description,
  showSidebar = true,
  sidebarPosition = "left",
  ogImage = "/images/back.jpg",
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const isSidebarLeft = sidebarPosition === "left";
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <script is:inline>
      const root = document.documentElement;
      const system = matchMedia("(prefers-color-scheme: dark)");
      function applyTheme(preference) {
        const mode = ["dark", "light"].includes(preference) ? preference : "system";
        const dark = mode === "system" ? system.matches : mode === "dark";
        root.dataset.preference = mode;
        root.dataset.theme = dark ? "dark" : "light";
        root.classList.toggle("dark", dark);
        document.dispatchEvent(new Event("themechange"));
      }
      let initial;
      try { initial = localStorage.getItem("theme"); } catch {}
      applyTheme(initial);
      system.addEventListener("change", () => applyTheme(root.dataset.preference));
      document.addEventListener("themechoice", (event) => {
        applyTheme(event.detail);
        try { localStorage.setItem("theme", root.dataset.preference); } catch {}
      });
      window.addEventListener("storage", (event) => {
        if (event.key === "theme" || event.key === null) applyTheme(event.newValue);
      });
    </script>
    <!-- Umami 统计（配置在 src/consts.ts → UMAMI_CONFIG） -->
    <!-- 部署时替换为你的真实 Umami 地址 -->
    <script
      defer
      src={UMAMI_CONFIG.scriptUrl}
      data-website-id={UMAMI_CONFIG.websiteId}
      data-domains={UMAMI_CONFIG.domains}
    ></script>
  </head>

  <body class="min-h-screen flex flex-col">
    <!-- ====== 顶部导航 ====== -->
    <a class="skip-link" href="#main">跳至正文</a>
    <Header />

    <!-- ====== 全宽 Banner（由各页面通过 slot="banner" 注入） ====== -->
    <slot name="banner" />

    <!-- ====== 主体区域：侧边栏 + 内容 ====== -->
    <main id="main" tabindex="-1" class="shell flex-1 py-8">
      <div class="flex flex-col lg:flex-row gap-8">
        {
          /* ---- 侧边栏在左侧 ---- */
          showSidebar && isSidebarLeft && (
            <Sidebar position="left" />
          )
        }

        <!-- ---- 内容区 ---- -->
        <div class="flex-1 min-w-0">
          <slot />
        </div>

        {
          /* ---- 侧边栏在右侧 ---- */
          showSidebar && !isSidebarLeft && (
            <Sidebar position="right" />
          )
        }
      </div>
    </main>

    <!-- ====== 底部页脚 ====== -->
    <Footer />
  </body>
</html>
