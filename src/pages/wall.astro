---
// ==============================
// 留言墙页 wall.astro — Giscus 评论集成
// ==============================
import Layout from "../layouts/Layout.astro";
import HeaderBanner from "../components/HeaderBanner.astro";
import { PAGE_BG_MAP } from "../consts";
import GiscusComment from "../components/GiscusComment.astro";
---

<Layout
  title="留言墙"
  description="在我的留言板上留下您的想法。欢迎留下近况、建议或问题，也可以只是来打个招呼。"
  showSidebar={false}
>
  <div slot="banner">
    <HeaderBanner
      title="留言墙"
      description="在我的留言板上留下您的想法。您可以在这里告诉我任何事情！"
      bgImage={PAGE_BG_MAP.wall}
    />
  </div>

  <div class="max-w-3xl mx-auto">
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-10">
      写一句近况、建议、问题，或者只是来打个招呼。
    </p>

    <GiscusComment />
  </div>
</Layout>