---
// ==============================
// 留言墙页 wall.astro — Giscus 评论集成
// ==============================
import Layout from "../layouts/Layout.astro";
import GiscusComment from "../components/GiscusComment.astro";
---

<Layout
  title="留言墙"
  description="在我的留言板上留下您的想法。欢迎留下近况、建议或问题，也可以只是来打个招呼。"
  showSidebar={false}
>
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight mb-2">
      留言墙
    </h1>
    <p class="text-gray-500 dark:text-gray-400 mb-4">
      在我的留言板上留下您的想法。您可以在这里告诉我任何事情！
    </p>
    <p class="text-sm text-gray-400 dark:text-gray-500 mb-10">
      写一句近况、建议、问题，或者只是来打个招呼。
    </p>

    <GiscusComment />
  </div>
</Layout>