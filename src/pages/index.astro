---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";
import albums from "../data/albums.json";
import { getPosts, postPath, readingMinutes } from "../utils/posts";
import Ownership from "../features/lab/Ownership.astro";
import Projects from "../features/home/Projects.astro";
const {posts} = await getPosts({limit:3});
---
<Layout title="首页" showSidebar={false}>
  <div class="garden">
    <section class="profile"><span class="avatar" aria-hidden="true">{profile.name[0]}</span><h1>{profile.headline}</h1><p>{profile.introduction}</p><a href="/about/">关于 {profile.name} ↗</a></section>
    <aside><h2>研究方向</h2><div class="topics">{profile.interests.map(t => <a href={`/categories/${t.toLowerCase()}/`}>{t}</a>)}</div><a href={profile.github}>在 GitHub 查看开发动态 ↗</a></aside>
    <div class="experiment"><Ownership link /></div>
    <section><h2>最新文章</h2>{posts.map(p => <a class="entry" href={postPath(p)}><small>{p.data.category} · {p.data.updatedDate ? "更新" : "发布"}于 {(p.data.updatedDate ?? p.data.publishedDate).toISOString().slice(0,10)} · {readingMinutes(p)} 分钟</small><strong>{p.data.title}</strong></a>)}<a href="/categories/all/">全部文章 ↗</a></section>
    <div class="projects"><Projects /></div>
    <section class="gallery"><h2>相册</h2><div class="photos">{albums.map(a => <a href={`/album/${a.slug}/`}><img src={a.cover} alt={a.name+"相册封面"} loading="lazy"/><strong>{a.name}</strong> · {a.count} 张</a>)}</div><a href="/album/">浏览相册 ↗</a></section>
    <section class="knowledge"><h2>iOS 知识库</h2><p>问答功能筹备中。先从已有笔记探索一个问题。</p><a href="/categories/runtime/">阅读 Runtime 笔记 ↗</a></section>
  </div>
</Layout>
<style>
.garden {display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:20px}
.garden > * {grid-column:span 4;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-card);padding:clamp(20px,3vw,40px);min-width:0}
.garden .profile,.garden .experiment {grid-column:span 8}
.garden .experiment {padding:0;background:var(--accent-soft)}
.garden .gallery,.garden .projects {grid-column:span 6}
.garden .knowledge {grid-column:1/-1}
.avatar {display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:var(--action);color:var(--on-action);font:italic 700 32px Georgia,serif}
h1 {font-size:clamp(34px,4.5vw,54px);line-height:1.06;letter-spacing:-.055em;font-weight:720;max-width:16ch;margin:22px 0 12px}
.garden :global(h2) {font-weight:700;font-size:24px;margin-bottom:12px}
.garden p,.entry small {color:var(--text-muted)}
.garden a {color:var(--accent)}
.profile a,.knowledge a,.gallery > a {display:inline-block;margin-top:18px}
.topics,.photos {display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}
.topics a {padding:6px 12px;background:var(--accent-soft);border-radius:999px}
.entry {display:grid;padding:12px 0;border-top:1px solid var(--border)}
.entry strong {color:var(--text)}
.photos {flex-wrap:nowrap;overflow:auto;scroll-snap-type:x mandatory}
.photos a {flex:0 0 75%;scroll-snap-align:start}
.photos img {width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:12px;margin-bottom:8px}
@media(max-width:1119px){.garden {grid-template-columns:repeat(2,minmax(0,1fr))}.garden > *,.garden .projects,.garden .gallery {grid-column:span 1}.garden .profile,.garden .experiment {grid-column:1/-1}}
@media(max-width:767px){.garden {grid-template-columns:minmax(0,1fr);gap:14px}}
</style>
