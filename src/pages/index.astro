---
// ==============================
// 首页 index.astro — 文章列表首页
// ==============================
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { getPosts } from "../utils/posts";

const { posts, pagination } = await getPosts({
  page: 1,
  pageSize: 5,
  sort: "newest",
});
---

<Layout
  title="首页"
  description="iOS 底层原理、Objective-C Runtime、Swift 与工程实践。"
>
  <!-- 网站简介 Banner -->
  <section class="mb-10">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight mb-3 text-balance">
      iOS 底层探索笔记
    </h1>
    <p class="text-base text-gray-500 dark:text-gray-400 max-w-2xl text-balance">
      Runtime、内存管理、多线程与工程实践 — 一个 iOS 开发者的技术实验室。
    </p>
  </section>

  <!-- 分割线 -->
  <div class="mb-8 border-t border-gray-100 dark:border-gray-800"></div>

  <!-- 最近更新标题 -->
  <h2 class="section-title">最近更新</h2>

  <!-- 文章列表 -->
  <div class="space-y-5">
    {posts.map((post) => (
      <PostCard
        title={post.data.title}
        description={post.data.description}
        date={post.data.publishedDate.toISOString()}
        tags={post.data.tags}
        slug={post.id.replace(/\.md$/, "")}
        cover={post.data.cover ? post.data.cover.src : undefined}
      />
    ))}
  </div>

  <!-- 分页 -->
  <Pagination currentPage={pagination.page} totalPages={pagination.totalPages} />
</Layout>