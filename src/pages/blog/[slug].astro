---
import Layout from "../../layouts/Layout.astro";
import TOC from "../../components/TOC.astro";
import GiscusComment from "../../components/GiscusComment.astro";
import Ownership from "../../features/lab/Ownership.astro";
import PostList from "../../features/articles/PostList.astro";
import {chronologicalPosts,postPath,readingMinutes,getRelatedPosts} from "../../utils/posts";
import "../../styles/prose.css";

export async function getStaticPaths(){
 const all=await chronologicalPosts();
 return all.map((post,i)=>({params:{slug:post.id.replace(/\.md$/,"")},props:{post,older:all[i+1],newer:all[i-1]}}));
}
const {post,older,newer}=Astro.props;
const {Content,headings}=await post.render();
const related=await getRelatedPosts(post,3);
---
<Layout title={post.data.title} description={post.data.description} ogImage={post.data.ogImage} showSidebar={false}>
<progress class="reading-progress" value="0" max="1" aria-label="正文阅读进度"></progress>
<div class="reader">
<header class="reading-head"><a href="/categories/all/">文章</a> / <a href={`/categories/${post.data.category.toLowerCase()}/`}>{post.data.category}</a>
<h1 class="reading-title">{post.data.title}</h1>
<p>发布于 <time>{post.data.publishedDate.toISOString().slice(0,10)}</time> · 约 {readingMinutes(post)} 分钟
{post.data.updatedDate && <span> · 更新于 {post.data.updatedDate.toISOString().slice(0,10)}</span>}</p>
<nav>{post.data.tags.map(t=><a href={`/categories/${t.toLowerCase()}/`}>#{t}</a>)}{post.data.series && <a href={`/articles/series/${post.data.series}/`}>系列 · {post.data.series}</a>}</nav></header>
<div class="reading-layout"><TOC headings={headings}/><div class="reading-column">
<article id="article-body"><div class="markdown"><Content/></div>{post.data.experiment==="ownership" && <Ownership/>}</article>
<nav class="adjacent" aria-label="按发布时间浏览">{older && <a href={postPath(older)}>上一篇 · {older.data.title}</a>}{newer && <a href={postPath(newer)}>下一篇 · {newer.data.title}</a>}</nav>
{related.length>0 && <section><h2>相关文章</h2><PostList posts={related}/></section>}
<GiscusComment/></div></div></div></Layout>
<script>
const article=document.querySelector<HTMLElement>("#article-body")!;
const progress=document.querySelector<HTMLProgressElement>(".reading-progress")!;
function update(){
 const rect=article.getBoundingClientRect();
 progress.value=Math.min(1,Math.max(0,(innerHeight-rect.top)/Math.max(1,rect.height)));
}
new ResizeObserver(update).observe(article);
window.addEventListener("scroll",update,{passive:true});
window.addEventListener("resize",update);
for(const pre of article.querySelectorAll(".markdown pre")){
 const button=document.createElement("button");
 button.type="button";button.className="copy-code";button.textContent="复制代码";
 const code=pre.textContent||"";
 pre.before(button);
 button.onclick=async()=>{
  try{await navigator.clipboard.writeText(code);button.textContent="已复制"}catch{button.textContent="请选中代码复制"}
 };
}
for(const img of article.querySelectorAll<HTMLImageElement>(".markdown img")){
 const fallback=()=>{
   const label=document.createElement("span");
   label.className="image-fallback";label.textContent="图片暂不可用 · "+(img.alt||"正文插图");
   img.replaceWith(label);
 };
 img.addEventListener("error",fallback,{once:true});
 if(img.complete && img.naturalWidth===0)fallback();
}
</script>
