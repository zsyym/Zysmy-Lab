---
import Layout from "../layouts/Layout.astro";
---
<Layout title="全文搜索" showSidebar={false}><div class="library">
<a href="/categories/all/">全部文章</a><h1>全文搜索</h1>
<label for="query">搜索标题、标签或正文</label>
<input id="query" type="search" autocomplete="off" placeholder="例如 retain 或消息发送" />
<p id="status" role="status"></p><button id="retry" hidden>重新加载</button><ul id="results"></ul>
</div></Layout>
<script>
import Fuse from "fuse.js";
interface Entry {title:string;description:string;href:string;tags:string[];body:string}
const input=document.querySelector<HTMLInputElement>("#query")!;
const status=document.querySelector("#status")!;
const results=document.querySelector("#results")!;
const retry=document.querySelector<HTMLButtonElement>("#retry")!;
let engine:Fuse<Entry>;
function render(){
 if(!engine)return;
 const query=input.value.trim();
 const hits=query?engine.search(query):[];
 status.textContent=query?(hits.length?`找到 ${hits.length} 篇文章`:"没有找到文章，请试试其他关键词。"):"输入关键词开始搜索";
 results.replaceChildren(...hits.map(({item})=>{
   const li=document.createElement("li");
   const a=document.createElement("a");
   a.href=item.href;
   a.textContent=item.title;
   li.append(a);
   return li;
 }));
}
async function load(){
 retry.hidden=true;
 status.textContent="正在加载文章索引…";
 try{
   const response=await fetch("/search-index.json");
   if(!response.ok)throw Error();
   engine=new Fuse(await response.json(),{keys:[{name:"title",weight:4},{name:"tags",weight:2},"description","body"],threshold:.22,ignoreLocation:true,ignoreFieldNorm:true});
   render();
 }catch{status.textContent="文章索引加载失败";retry.hidden=false;}
}
input.value=new URL(location.href).searchParams.get("q")||"";
input.addEventListener("input",()=>{
 const url=new URL(location.href);
 if(input.value)url.searchParams.set("q",input.value);else url.searchParams.delete("q");
 history.replaceState(null,"",url);
 render();
});
retry.onclick=load;
load();
</script>
<style>
input {display:block;width:100%;background:var(--surface);border:1px solid var(--control-border);border-radius:8px;padding:12px;margin:8px 0 16px}
#results :global(li){padding:14px 0;border-bottom:1px solid var(--border)}
</style>
