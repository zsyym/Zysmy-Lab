---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../features/articles/PostList.astro";
import {chronologicalPosts} from "../../utils/posts";
const posts=await chronologicalPosts();
const years=[...new Set(posts.map(p=>p.data.publishedDate.getUTCFullYear()))];
---
<Layout title="文章归档" showSidebar={false}><div class="library"><a href="/categories/all/">全部文章</a><h1>文章归档</h1>{years.map(year=><section><h2>{year}</h2><PostList posts={posts.filter(p=>p.data.publishedDate.getUTCFullYear()===year)}/></section>)}</div></Layout>
