---
// ==============================
// 分类页 [slug].astro — 时间轴文章列表
// ==============================
// /all 页面按年份分组，类似参考站点的时间轴布局
// /[tag] 页面按标签筛选
// ==============================
import Layout from "../../layouts/Layout.astro";
import HeaderBanner from "../../components/HeaderBanner.astro";
import { PAGE_BG_MAP } from "../../consts";
import { getPosts, getTags } from "../../utils/posts";

export async function getStaticPaths() {
  const tags = await getTags();
  const slugs = ["all", ...tags.map((t) => t.name.toLowerCase())];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const tagName = slug === "all" ? "全部文章" : slug;

const { posts: allPosts } = await getPosts({ pageSize: 100 });
const filtered =
  slug === "all"
    ? allPosts
    : allPosts.filter((p) =>
        p.data.tags.some((t) => t.toLowerCase() === slug!.toLowerCase()),
      );

// 按年份分组
const postsByYear = new Map<string, typeof filtered>();
for (const post of filtered) {
  const year = post.data.publishedDate.getFullYear().toString();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}
const sortedYears = Array.from(postsByYear.entries()).sort((a, b) => Number(b[0]) - Number(a[0]));
---

<Layout title={`分类: ${tagName}`}>
  <div slot="banner">
    <HeaderBanner
      title={tagName}
      description={slug === "all" ? "所有的思绪与技术积累，都在这里留下足迹。" : `标签: ${tagName} — 共 ${filtered.length} 篇文章`}
      bgImage={PAGE_BG_MAP.categories}
    />
  </div>

  {
    filtered.length > 0 ? (
      <div class="space-y-10">
        {sortedYears.map(([year, yearPosts]) => (
          <section>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-primary-500"></span>
              {year}
              <span class="text-sm font-normal text-gray-400 dark:text-gray-500">
                {yearPosts.length} 篇文章
              </span>
            </h2>

            <div class="space-y-4">
              {yearPosts.map((post) => (
                <a
                  href={`/blog/${post.id.replace(/\.md$/, "")}`}
                  class="card p-5 sm:p-6 flex items-start gap-4 no-underline group hover:-translate-y-0.5 transition-all duration-200"
                >
                  <!-- 日期左侧 -->
                  <div class="hidden sm:block w-16 shrink-0 text-right">
                    <div class="text-sm font-bold text-gray-700 dark:text-gray-300">
                      {post.data.publishedDate.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}
                    </div>
                    <div class="text-xs text-gray-400 dark:text-gray-500">
                      {post.data.publishedDate.getFullYear()}
                    </div>
                  </div>

                  <!-- 时间轴竖线圆点 -->
                  <div class="hidden sm:flex flex-col items-center shrink-0">
                    <div class="w-2 h-2 rounded-full bg-primary-500 ring-2 ring-white dark:ring-gray-950"></div>
                    <div class="w-px flex-1 bg-gray-200 dark:bg-gray-700 min-h-[24px]"></div>
                  </div>

                  <!-- 文章内容 -->
                  <div class="flex-1 min-w-0">
                    {/* 移动端日期 */}
                    <div class="sm:hidden text-xs text-gray-400 dark:text-gray-500 mb-1">
                      {post.data.publishedDate.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
                    </div>
                    <h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                      {post.data.title}
                    </h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 line-clamp-1">
                      {post.data.description}
                    </p>
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      {post.data.tags.map((t) => (
                        <span class="text-xs text-primary-600 dark:text-primary-400">#{t}</span>
                      ))}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="card p-10 text-center text-gray-400 dark:text-gray-500">
        <p class="text-lg mb-2">暂无相关文章</p>
        <p class="text-sm">该分类下还没有内容，敬请期待。</p>
      </div>
    )
  }
</Layout>