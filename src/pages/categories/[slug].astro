---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../features/articles/PostList.astro";
import {chronologicalPosts,getTags,getCategories} from "../../utils/posts";
export async function getStaticPaths(){
  const labels=[...(await getTags()),...(await getCategories())].map(t=>t.name.toLowerCase());
  return [...new Set(["all",...labels])].map(slug=>({params:{slug}}));
}
const {slug}=Astro.params;
const posts=await chronologicalPosts();
const categories=await getCategories();
const tags=await getTags();
const selected=[...categories,...tags].find(t=>t.name.toLowerCase()===slug)?.name;
const filtered=posts.filter(p=>slug==="all" || [p.data.category,...p.data.tags].some(t=>t.toLowerCase()===slug));
---
<Layout title={selected || "文章"} showSidebar={false}><div class="library">
<h1>{selected || "文章"}</h1>
<nav aria-label="阅读工具"><a href="/search/">全文搜索</a><a href="/articles/series/">文章系列</a><a href="/articles/archive/">按年归档</a></nav>
<div class="filters"><a href="/categories/all/">全部文章</a>
{[{name:"分类",items:categories},{name:"标签",items:tags}].map(group=><div><b>{group.name}</b>{group.items.map(t=><a aria-current={t.name===selected?"page":undefined} href={`/categories/${t.name.toLowerCase()}/`}>{t.name}</a>)}</div>)}</div>
<p>{filtered.length} 篇文章</p><PostList posts={filtered}/></div></Layout>
