---
import { NAV_ITEMS, SITE } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
function active(href: string) {
  if (href === "/categories/all") return /^\/(categories|blog)\//.test(path);
  return href === path || (href !== "/" && path.startsWith(href + "/"));
}
---
<header class="masthead">
  <nav class="shell mast-row" aria-label="主导航">
    <a class="wordmark" href="/">{SITE.title}</a>
    <div class="mast-links">
      {NAV_ITEMS.map(({label,href}) => <a href={href} aria-current={active(href) ? "location" : undefined}>{label}</a>)}
    </div>
    <div class="mast-tools">
      <a href="/search/" class="tool" aria-label="搜索">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg>
      </a>
      <ThemeToggle />
      <details class="compact-menu">
        <summary class="tool" aria-label="导航菜单">☰</summary>
        <div class="compact-links">
          {NAV_ITEMS.map(({label,href}) => <a href={href} aria-current={active(href) ? "location" : undefined}>{label}</a>)}
        </div>
      </details>
    </div>
  </nav>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".compact-menu")!;
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>
