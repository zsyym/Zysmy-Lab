---
// ==============================
// PostCard.astro — 文章列表卡片
// ==============================
import TagBadge from "./TagBadge.astro";

interface Props {
  title: string;
  description?: string;
  date: string;
  tags: string[];
  slug: string;
  cover?: string;
}

const { title, description, date, tags, slug, cover } = Astro.props;

// 格式化日期
const formattedDate = new Date(date).toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article
  class="card group overflow-hidden border border-gray-100/80 dark:border-gray-800/80
         hover:-translate-y-1 hover:border-gray-200 dark:hover:border-gray-700
         transition-all duration-300 ease-out"
>
  <a href={`/blog/${slug}`} class="block no-underline">
    <div class="flex flex-col md:flex-row">
      {cover && (
        <div class="md:w-56 lg:w-64 shrink-0 bg-gray-100 dark:bg-gray-800">
          <img
            src={cover}
            alt={title}
            class="h-52 md:h-full w-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
            loading="lazy"
          />
        </div>
      )}

      <div class="flex-1 p-5 sm:p-6">
        <!-- 日期 + 标签 -->
        <div class="flex items-center gap-3 mb-3 text-xs text-gray-400 dark:text-gray-500">
          <a href={`/blog/${slug}`} class="no-underline hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
            <time datetime={date}>{formattedDate}</time>
          </a>
          {tags.length > 0 && <span>·</span>}
          <div class="flex flex-wrap gap-1.5">
            {tags.slice(0, 3).map((t) => (
              <TagBadge tag={t} href={`/categories/${t.toLowerCase()}`} />
            ))}
          </div>
        </div>

        <!-- 标题 -->
        <h2 class="text-lg sm:text-xl font-semibold mb-2 leading-snug text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
          <a href={`/blog/${slug}`} class="no-underline text-inherit">
            {title}
          </a>
        </h2>

        <!-- 摘要 -->
        {description && (
          <a href={`/blog/${slug}`} class="block no-underline">
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed line-clamp-2 mb-4">
              {description}
            </p>
          </a>
        )}

        <!-- 阅读更多 -->
        <a
          href={`/blog/${slug}`}
          class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 dark:text-primary-400
                 hover:text-primary-700 dark:hover:text-primary-300 no-underline transition-colors duration-200"
        >
          阅读全文
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </a>
</article>

