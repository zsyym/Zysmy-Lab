---
// ==============================
// TOC.astro — 文章目录侧边栏
// ==============================
// 自动提取文章中 h2 / h3 标题生成目录
// 固定在右侧，跟随滚动高亮当前章节
// ==============================
interface Props {
  /** 文章内容的 HTML 字符串（用于提取标题） */
  contentHtml?: string;
}

const { contentHtml = "" } = Astro.props;

// 提取 h2 / h3 标题
const headingRegex = /<h([23])[^>]*id="([^"]+)"[^>]*>(.*?)<\/h[23]>/gi;
const headings: { level: number; id: string; text: string }[] = [];
let match;
while ((match = headingRegex.exec(contentHtml)) !== null) {
  headings.push({
    level: parseInt(match[1]),
    id: match[2],
    text: match[3].replace(/<[^>]*>/g, ""),
  });
}
---

{
  headings.length > 1 && (
    <div class="hidden xl:block w-56 shrink-0">
      <div class="sticky top-24 space-y-4">
        <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">
          目录
        </h4>
        <nav class="space-y-1.5" id="toc-nav">
          {headings.map((h) => (
            <a
              href={`#${h.id}`}
              class={`block text-sm no-underline transition-colors duration-200 hover:text-primary-400 ${
                h.level === 2
                  ? "text-gray-300 font-medium"
                  : "text-gray-500 pl-4"
              }`}
            >
              {h.text}
            </a>
          ))}
        </nav>
      </div>
    </div>
  )
}