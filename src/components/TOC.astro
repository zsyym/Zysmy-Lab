---
import type {MarkdownHeading} from "astro";
interface Props { headings:MarkdownHeading[] }
const items=Astro.props.headings.filter(h=>h.depth<=3);
---
{items.length>0 && <details class="toc"><summary>本文目录</summary><nav aria-label="本文目录">{items.map(h=><a style={`padding-inline-start:${(h.depth-1)*.5}rem`} href={`#${h.slug}`}>{h.text}</a>)}</nav></details>}
<script>
const toc=document.querySelector<HTMLDetailsElement>(".toc");
if(toc){
 const desktop=matchMedia("(min-width: 960px)");
 const resize=()=>{toc.open=desktop.matches};
 resize(); desktop.addEventListener("change",resize);
 const links=[...toc.querySelectorAll("a")];
 const items=links.map(a=>document.getElementById(decodeURIComponent(a.hash.slice(1))));
 function update(){
   let index=0;
   items.forEach((el,i)=>{if(el && el.getBoundingClientRect().top<=110)index=i});
   links.forEach((a,i)=>{if(i===index)a.setAttribute("aria-current","location");else a.removeAttribute("aria-current")});
 }
 const observer=new IntersectionObserver(update,{rootMargin:"-72px 0px -60% 0px"});
 items.forEach(el=>el && observer.observe(el));
 toc.addEventListener("click",event=>{if(!desktop.matches && event.target instanceof HTMLAnchorElement)toc.open=false});
}
</script>
<style>
.toc {padding:16px;border:1px solid var(--border);border-radius:12px;background:var(--surface);align-self:start}
summary {cursor:pointer;font-weight:650}
nav {margin-top:12px;max-height:55vh;overflow:auto}
a {display:block;padding-block:5px;font-size:14px;color:var(--text-muted);overflow-wrap:anywhere}
a[aria-current] {color:var(--accent);font-weight:650}
@media(min-width:960px){.toc {grid-column:2;grid-row:1;position:sticky;top:84px}}
</style>
