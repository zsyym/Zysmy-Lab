<select id="theme-choice" aria-label="配色主题" class="theme-choice">
  <option value="system">随系统</option>
  <option value="light">浅色</option>
  <option value="dark">深色</option>
</select>
<script>
  const choice = document.querySelector<HTMLSelectElement>("#theme-choice")!;
  function sync() {
    choice.value = document.documentElement.dataset.preference || "system";
  }
  sync();
  document.addEventListener("themechange", sync);
  choice.addEventListener("change", () => {
    document.dispatchEvent(new CustomEvent("themechoice", {detail: choice.value}));
  });
</script>
