---
// ==============================
// Sidebar.astro — 左侧/右侧侧边栏
// 包含：个人头像、简介、社交链接、热门标签
// ==============================
import { SOCIALS, SITE } from "../consts";
import { getTags } from "../utils/posts";
const tags = await getTags();
import TagBadge from "./TagBadge.astro";

// 可配置：sidebar 放在左侧还是右侧
interface Props {
  position?: "left" | "right";
}

const { position = "left" } = Astro.props;

// SVG 图标映射
const iconMap: Record<string, string> = {
  github: "M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z",
  email: "M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm16 3.38V6H4v1.38l8 4 8-4zm0 2.84l-8 4-8-4V18h16v-7.78z",
  twitter: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  rss: "M6.002 5.883a15.117 15.117 0 0112.115 12.115M6.002 10.436a10.57 10.57 0 017.562 7.562M7.627 14.62a1.75 1.75 0 110 3.5 1.75 1.75 0 010-3.5z",
};
---

<aside class="w-full lg:w-72 shrink-0" data-position={position}>
  <div class="sticky top-24 space-y-6">

    <!-- ====== 个人信息卡片 ====== -->
    <div class="card p-6 text-center">
      <!-- 头像 -->
      <div class="mb-4">
        <div
          class="mx-auto w-20 h-20 rounded-full bg-gradient-to-br from-primary-400 to-accent-500
                 flex items-center justify-center text-white text-3xl font-bold shadow-lg"
        >
          {SITE.author.charAt(0)}
        </div>
      </div>

      <!-- 昵称 -->
      <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">
        {SITE.author}
      </h3>

      <!-- 简介 -->
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-4">
        {SITE.description}
      </p>

      <!-- 社交图标 -->
      <div class="flex items-center justify-center gap-3">
        {SOCIALS.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 flex items-center justify-center rounded-lg
                   text-gray-400 hover:text-primary-600 hover:bg-gray-100
                   dark:hover:text-primary-400 dark:hover:bg-gray-800
                   transition-all duration-200"
            title={s.name}
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d={iconMap[s.icon] || ""} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- ====== 热门标签 ====== -->
    <div class="card p-5">
      <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3 uppercase tracking-wider">
        热门标签
      </h4>
      <div class="flex flex-wrap gap-2">
        {tags.map(({name: tag}) => (
          <TagBadge tag={tag} href={`/categories/${tag.toLowerCase()}`} />
        ))}
      </div>
    </div>

  </div>
</aside>
