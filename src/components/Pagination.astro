---
// ==============================
// Pagination.astro — 分页组件
// ==============================
interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string;
}

const { currentPage, totalPages, basePath = "" } = Astro.props;
---

{
  totalPages > 1 && (
    <nav class="flex items-center justify-center gap-2 mt-10" aria-label="分页">
      <!-- 上一页 -->
      {
        currentPage > 1 ? (
          <a
            href={`${basePath}/page/${currentPage - 1}`}
            class="flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium
                   text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800
                   no-underline transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M15 18l-6-6 6-6" />
            </svg>
            上一页
          </a>
        ) : (
          <span
            class="flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium
                   text-gray-300 dark:text-gray-700 cursor-not-allowed"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M15 18l-6-6 6-6" />
            </svg>
            上一页
          </span>
        )
      }

      <!-- 页码 -->
      <div class="flex items-center gap-1">
        {
          Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
            <a
              href={page === 1 ? `${basePath}/` : `${basePath}/page/${page}`}
              class={`w-9 h-9 flex items-center justify-center rounded-lg text-sm font-medium no-underline transition-colors ${
                page === currentPage
                  ? "bg-primary-600 text-white dark:bg-primary-500"
                  : "text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800"
              }`}
            >
              {page}
            </a>
          ))
        }
      </div>

      <!-- 下一页 -->
      {
        currentPage < totalPages ? (
          <a
            href={`${basePath}/page/${currentPage + 1}`}
            class="flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium
                   text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800
                   no-underline transition-colors"
          >
            下一页
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 18l6-6-6-6" />
            </svg>
          </a>
        ) : (
          <span
            class="flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium
                   text-gray-300 dark:text-gray-700 cursor-not-allowed"
          >
            下一页
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 18l6-6-6-6" />
            </svg>
          </span>
        )
      }
    </nav>
  )
}
