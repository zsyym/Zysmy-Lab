---
// ==============================
// GiscusComment.astro — 通用 Giscus 评论组件
// ==============================
// 配置位置: src/consts.ts → GISCUS_CONFIG
// 获取 repo-id 和 category-id: https://giscus.app/zh-CN
// ==============================
import { GISCUS_CONFIG } from "../consts";

interface Props {
  /** 评论映射方式，默认 pathname */
  mapping?: "pathname" | "url" | "title" | "og:title";
  /** 输入位置，默认 top */
  inputPosition?: "top" | "bottom";
  /** 反应表情，默认 1 */
  reactionsEnabled?: "0" | "1";
}

const {
  mapping = "pathname",
  inputPosition = "top",
  reactionsEnabled = "1",
} = Astro.props;
---

<div class="giscus mt-12 pt-8 border-t border-gray-100 dark:border-gray-800">
  <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-6">
    💬 评论
  </h3>

  <div
    id="giscus-comments"
    data-repo={GISCUS_CONFIG.repo}
    data-repo-id={GISCUS_CONFIG.repoId}
    data-category={GISCUS_CONFIG.category}
    data-category-id={GISCUS_CONFIG.categoryId}
    data-mapping={mapping}
    data-strict="0"
    data-reactions-enabled={reactionsEnabled}
    data-emit-metadata="0"
    data-input-position={inputPosition}
    data-theme="preferred_color_scheme"
    data-lang="zh-CN"
    data-loading="lazy"
  ></div>
</div>

<script>
  // 从服务端注入的配置
  const CONFIG = {
    repo: "yourname/your-repo",
    repoId: "YOUR_REPO_ID",
    category: "Announcements",
    categoryId: "YOUR_CATEGORY_ID",
  };

  const script = document.createElement("script");
  script.src = "https://giscus.app/client.js";
  script.setAttribute("data-repo", CONFIG.repo);
  script.setAttribute("data-repo-id", CONFIG.repoId);
  script.setAttribute("data-category", CONFIG.category);
  script.setAttribute("data-category-id", CONFIG.categoryId);
  script.setAttribute("data-mapping", "pathname");
  script.setAttribute("data-strict", "0");
  script.setAttribute("data-reactions-enabled", "1");
  script.setAttribute("data-emit-metadata", "0");
  script.setAttribute("data-input-position", "top");
  script.setAttribute("data-theme", "preferred_color_scheme");
  script.setAttribute("data-lang", "zh-CN");
  script.setAttribute("crossorigin", "anonymous");
  script.setAttribute("data-loading", "lazy");
  script.async = true;
  document.getElementById("giscus-comments")?.appendChild(script);
</script>