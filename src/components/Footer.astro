---
import { SITE, SOCIALS, NAV_ITEMS } from "../consts";
const groups = [
  {title:"浏览", links:NAV_ITEMS.filter(item => item.href !== "/")},
  {title:"本站", links:[{label:"关于我",href:"/about/"},{label:"资源",href:"/resources/"},{label:"站点地图",href:"/sitemap-index.xml"}]},
  {title:"联系", links:SOCIALS.map(item => ({label:item.name,href:item.url}))},
];
---
<footer class="site-footer">
  <div class="shell foot-grid">
    <div class="foot-brand"><a href="/">{SITE.title}</a><p>{SITE.description}</p></div>
    {groups.map(group => <section><h2>{group.title}</h2><ul>{group.links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul></section>)}
  </div>
  <div class="shell foot-credit">© {new Date().getFullYear()} {SITE.author}<a href="https://astro.build">Powered by Astro</a></div>
</footer>
